# Copy to .env and fill in. NEVER commit .env. Placeholders only below.

# --- Dashboard access (required when binding to anything other than 127.0.0.1) ---
TRADELAB_DASHBOARD_USER=admin
TRADELAB_DASHBOARD_PASSWORD=change-me-to-a-long-random-string

# --- Storage ---
TRADELAB_DATA_DIR=./data

# --- Market data mode: "mock" (default, synthetic) or "kite" (needs Kite Connect paid plan) ---
TRADELAB_MARKET_DATA=mock

# --- Zerodha Kite Connect (read-only market data + login only; NO order endpoints exist in this app) ---
# Create an app at https://developers.kite.trade/ . Redirect URL must match TRADELAB_KITE_REDIRECT_URL.
TRADELAB_KITE_API_KEY=your_api_key_here
TRADELAB_KITE_API_SECRET=your_api_secret_here
TRADELAB_KITE_REDIRECT_URL=http://127.0.0.1:8000/auth/kite/callback

# --- Scheduler: set to false to run the dashboard without automated jobs ---
TRADELAB_SCHEDULER_ENABLED=true
# Monitoring poll interval during market hours, in seconds (monitoring never forces trades)
TRADELAB_MONITOR_INTERVAL_S=60
